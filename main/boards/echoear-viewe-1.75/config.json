{
  "type": "echoear-viewe-1.75",
  "target": "esp32s3",
  "builds": [
    {
      "name": "echoear-viewe-1.75",
      "sdkconfig_append": [
        "CONFIG_BOARD_TYPE_ECHOEAR_VIEWE_1_75=y",
        "CONFIG_USE_WECHAT_MESSAGE_STYLE=n",
        "CONFIG_USE_DEVICE_AEC=n",
        "CONFIG_LV_USE_KEYBOARD=y",
        "CONFIG_ECHOEAR_UI_REVIEW=n",
        "CONFIG_ESPTOOLPY_FLASHMODE_DIO=y",
        "CONFIG_FLASH_CUSTOM_ASSETS=y",
        "CONFIG_CUSTOM_ASSETS_FILE=\"../../assets/custom/assets-with-font.bin\""
      ]
    }
  ]
}
